# ============================================================
# AI Certificate Agent - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# LLM Provider Selection
# Options: ollama, openai, anthropic, deepseek, groq
# ------------------------------------------------------------
LLM_PROVIDER=groq

# ------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=certificate_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------
# Provider: Groq (FREE - 14,400 req/day)
# Sign up: https://console.groq.com
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ------------------------------------------------------------
# Provider: Ollama (LOCAL - Free, runs on your machine)
# Install: https://ollama.ai
# Pull model: ollama pull qwen2.5:3b
# ------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------------------------
# Provider: OpenAI (PAID)
# Sign up: https://platform.openai.com
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# Provider: Anthropic (PAID)
# Sign up: https://console.anthropic.com
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# Provider: DeepSeek (AFFORDABLE)
# Sign up: https://platform.deepseek.com
# ------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# n8n Configuration
# ------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=admin

# ------------------------------------------------------------
# Agent Settings
# ------------------------------------------------------------
AUDIO_DIR=/tmp/audio
OUTPUT_DIR=./output

# ------------------------------------------------------------
# Telegram Bot (Optional - for notifications)
# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
